# SynapseAI Environment Configuration Template
# NOTE: Task 1 runs locally without any API keys, credentials, or paid cloud services.
# The keys below are placeholders for upcoming pipeline modules (Task 2+).

# Application Settings
SYNAPSE_APP_ENV=development
SYNAPSE_DEBUG=true

# Embedding & LLM Provider Settings (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Persistent Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Persistent Graph Database (Neo4j - Optional / Hackathon Requirement)
# Connect to a local Neo4j instance (e.g. Neo4j Desktop / Docker) or Neo4j Aura cloud instance
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
